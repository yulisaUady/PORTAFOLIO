
	Algoritmo factorial
		definir n, i, factor, num, ini  como entero;
		escribir "¿a cuantos numeros le quieres calcular el factorial?";
		leer n;
		Para i<-1 Hasta n  Hacer
			escribir " introduce el numero";
			leer num;
			factor<-1;
			para ini <-1 hasta num Hacer
				factor<- factor * ini;
			FinPara
			escribir " el factorial de el numero es:", factor;
		Fin Para
		
FinAlgoritmo

