Algoritmo imprimirUnRectanguloDeAsteriscos
	//entrada: ancho, largo, i, j
	//salida: *
	//caso de prueba: ancho:2, largo:3
	//***
	//***
		definir ancho, largo, i, j como entero;
		escribir "proporcione el ancho";
		leer ancho;
		escribir "proporcione el largo";
		leer largo;
		para i<-1 hasta ancho Hacer
			
			para j<- 1 hasta largo Hacer
				escribir "* " sin saltar;
			FinPara
			escribir " ";
		FinPara
FinAlgoritmo

